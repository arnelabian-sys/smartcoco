# Copy this file to `.env` and adjust the values.

SMARTCOCO_DATABASE_URL=postgresql+psycopg://smartcoco:smartcoco@localhost:5432/smartcoco

SMARTCOCO_SECRET_KEY=replace-with-a-long-random-string
SMARTCOCO_ACCESS_TOKEN_TTL_MINUTES=480

# Provisioned administrator (inserted on first start)
SMARTCOCO_ADMIN_NAME=Admin User
SMARTCOCO_ADMIN_EMAIL=admin@smartcoco.ph
SMARTCOCO_ADMIN_PASSWORD=Admin123

SMARTCOCO_UPLOADS_DIR=uploads
SMARTCOCO_MAX_UPLOAD_MB=8

# Comma separated origins, or * during development
SMARTCOCO_CORS_ORIGINS=*

SMARTCOCO_AUTO_CREATE_TABLES=true
SMARTCOCO_SEED_DEMO_DATA=true
